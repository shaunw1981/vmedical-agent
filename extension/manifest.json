{
  "manifest_version": 3,
  "name": "Valley Medical — Reminders",
  "version": "1.0.0",
  "description": "Schedule appointment reminders and post-visit follow-ups in the Valley Medical dashboard from anywhere in Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Valley Medical Reminders",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
