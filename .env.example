# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# The .env file is ignored by git, so your settings never leave this Mac.

# ---------------------------------------------------------------------------
# Obsidian vault (the "brain") — where notes are written for staff to read
# ---------------------------------------------------------------------------
# The full path to the folder Obsidian opens as this client's vault. On a Mac it
# usually looks like the example below. To find it: open Obsidian, click the
# vault name (bottom-left) -> "Manage vaults" -> it shows the folder path.
# Leave blank to skip Obsidian and store notes only in the local database.
OBSIDIAN_VAULT_PATH=/Users/USERNAME/Documents/SpaVault
# Notes are placed in this subfolder inside the vault so they stay tidy.
OBSIDIAN_SUBFOLDER=vMedical Agent

# A small local database copy is also kept as a reliable backup/log.
DB_PATH=data/notes.db

# ---------------------------------------------------------------------------
# AI tidy-up (OPTIONAL, and OFF by default)
# ---------------------------------------------------------------------------
# "off"  = notes are stored exactly as received. Nothing leaves this Mac. (safe default)
# "on"   = voicemail transcripts are sent to Anthropic to be rewritten into a
#          clean note. This means that text leaves the Mac. Only turn this on if
#          you're comfortable with that.
AI_CLEANUP=off

# Only needed if AI_CLEANUP=on. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model to use for tidy-up (only used when AI_CLEANUP=on).
MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# GoHighLevel connection (fill in when you're ready to wire up the pull sync)
# ---------------------------------------------------------------------------
# See SETUP-MACMINI.md, section "Connecting GoHighLevel", for where to get these.
GHL_API_TOKEN=
GHL_LOCATION_ID=
