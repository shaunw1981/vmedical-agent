# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# The .env file is ignored by git, so your settings never leave this Mac.

# ---------------------------------------------------------------------------
# Web address & security
# ---------------------------------------------------------------------------
# The public web address of the dashboard (your secure Cloudflare Tunnel URL).
# Google login redirects back here, so it must match what you set in Google.
BASE_URL=https://spa.example.com

# A long random secret used to keep logins secure. Generate one on the Mac with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=paste-a-long-random-value-here

# ---------------------------------------------------------------------------
# Google Sign-in (from Google Cloud Console — see SETUP-MACMINI.md)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow logins from the team's Google Workspace domain (the part after the @).
# You can list several, comma-separated. Leave blank to allow any Google account.
ALLOWED_EMAIL_DOMAIN=vmedical.ca

# This email becomes the Super Admin automatically on first login, and is ALWAYS
# allowed even if its domain isn't in the list above (e.g. an outside admin).
SUPER_ADMIN_EMAIL=you@yourdomain.com

# Optional: extra individual emails always allowed to sign in, comma-separated.
EXTRA_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Obsidian vault (the "brain") — where transcripts are filed per client
# ---------------------------------------------------------------------------
# Full path to the folder Obsidian opens as this client's vault. To find it:
# open Obsidian -> click the vault name (bottom-left) -> Manage vaults.
OBSIDIAN_VAULT_PATH=/Users/USERNAME/Documents/SpaVault
OBSIDIAN_SUBFOLDER=vMedical Agent

# ---------------------------------------------------------------------------
# GoHighLevel after-hours call webhook
# ---------------------------------------------------------------------------
# A password you make up. GoHighLevel must send it so only GHL can post calls
# to the dashboard. Use it as ?secret=... on the webhook URL (see the guide).
GHL_WEBHOOK_SECRET=make-up-a-long-password

# ---------------------------------------------------------------------------
# GoHighLevel social metrics (the "Social" tab)
# ---------------------------------------------------------------------------
# A sub-account Private Integration Token (GHL -> Settings -> Private
# Integrations) with the two read-only scopes "View Social Planner Accounts"
# and "View Social Planner Posts". Leave blank to keep the Social tab showing
# its setup instructions.
GHL_API_TOKEN=
# The GHL location (sub-account) id(s) whose pages to show. Label each so the
# dashboard reads nicely; comma-separate multiple locations:
#   GHL_LOCATIONS=Kentville=abc123,New Minas=def456
GHL_LOCATIONS=

# ---------------------------------------------------------------------------
# Appointment reminders (the "Reminders" tab)
# ---------------------------------------------------------------------------
# Scheduling a reminder creates/updates the contact in GoHighLevel and adds
# them to the workflow you map to that appointment type (mapped in-app under
# Reminders → Reminder settings). The GHL_API_TOKEN above needs these extra
# scopes for this: "View Contacts", "Edit Contacts", and "View Workflows".
#
# Which sub-account the contacts + workflows live in. Defaults to the first
# GHL_LOCATIONS entry; set this to use a different one.
GHL_REMINDER_LOCATION=
# The clinic's timezone, so "2pm" means 2pm locally when handed to GoHighLevel.
# Any IANA name: America/Halifax, America/Toronto, America/Vancouver, etc.
TIMEZONE=America/Halifax
# How long a booked appointment lasts (minutes). Only used when a type is also
# linked to a calendar under Reminder settings (which books a real appointment).
APPOINTMENT_DURATION_MINUTES=60
# Optional API key for a future Chrome extension to call the JSON endpoints
# (contact lookup + schedule reminder). Leave blank to keep them login-only.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# ---------------------------------------------------------------------------
# Email monitor — reads the "AI Call Recap" emails and adds them to the dashboard
# ---------------------------------------------------------------------------
# The mailbox to watch, and its 16-character Google App Password (NOT the normal
# password). Leave IMAP_USER/IMAP_PASSWORD blank to turn the email monitor off.
IMAP_USER=assistant@vmedical.ca
IMAP_PASSWORD=your-16-character-app-password
# These defaults already match your setup — only change if the emails change.
IMAP_HOST=imap.gmail.com
RECAP_FROM=reply@c.clientconnector.app
RECAP_SUBJECT_PREFIX=AI Call Recap

# ---------------------------------------------------------------------------
# Charlie — the AI assistant ("Ask Charlie")
# ---------------------------------------------------------------------------
# An Anthropic API key (console.anthropic.com). Charlie answers the team's
# questions grounded in the Obsidian knowledge base. Leave blank to keep the
# Ask Charlie tab in its setup state.
ANTHROPIC_API_KEY=
# Which model Charlie uses. claude-opus-5 is the most capable; set
# claude-sonnet-5 for lower cost. Optional; defaults to claude-opus-5.
CHARLIE_MODEL=claude-opus-5
# Optional: what to call the assistant (defaults to "Charlie").
CHARLIE_NAME=Charlie

# Where the local database file is stored on this Mac.
DB_PATH=data/app.db
