# Copy this file to ".env" and fill in your real values.
# The .env file is ignored by git, so your secrets never end up on GitHub.
#
#   cp .env.example .env
#   nano .env        (edit, then press Ctrl+O, Enter, Ctrl+X to save)

# REQUIRED: your Anthropic API key. Get it from https://console.anthropic.com
# (Settings -> API Keys). It starts with "sk-ant-".
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: which Claude model to use. Leave as-is unless you have a reason.
MODEL=claude-sonnet-5

# OPTIONAL: change the agent's behavior/personality by editing this text.
# SYSTEM_PROMPT=You are vMedical Agent, a careful medical-information assistant...
