# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GoHighLevel (Valley Medical location) ---
GHL_LOCATION_ID=your-location-id
GHL_PRIVATE_TOKEN=pit-...
