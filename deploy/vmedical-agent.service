# systemd service file for vmedical-agent.
#
# "systemd" is the part of Linux that runs background services and makes sure
# they start on boot and restart if they crash. The setup.sh script copies this
# file into place for you — you do not normally edit it by hand.

[Unit]
Description=vmedical-agent web service
After=network.target

[Service]
Type=simple
User=vmedical
WorkingDirectory=/opt/vmedical-agent
# Load secrets (API key, etc.) from the .env file.
EnvironmentFile=/opt/vmedical-agent/.env
# Start the web server. It listens on port 8000, only on the local machine;
# nginx (see nginx.conf.example) forwards public traffic to it.
ExecStart=/opt/vmedical-agent/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
