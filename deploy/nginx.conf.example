# nginx reverse-proxy config for vmedical-agent.
#
# nginx is the "front door" that receives traffic from the internet on the
# normal web port (80) and passes it to your app running quietly on port 8000.
# This lets you later add a domain name and free HTTPS (a padlock) easily.
#
# The setup.sh script installs this for you. If you have a domain name, replace
# "_" below with your domain (e.g. agent.example.com) and then run certbot to
# turn on HTTPS (SETUP.md explains this in the optional section).

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
